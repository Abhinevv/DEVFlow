# Copy to backend/.env and adjust. All settings use the DEVFLOW_ prefix.

# --- Model provider ---------------------------------------------------------
# "mock" runs a deterministic scripted scenario (no API key, no cost).
# "anthropic" uses the Claude API; credentials come from ANTHROPIC_API_KEY or `ant auth login`.
DEVFLOW_LLM_PROVIDER=mock
DEVFLOW_LLM_MODEL=claude-opus-5-5
DEVFLOW_LLM_EFFORT=high
# ANTHROPIC_API_KEY=sk-ant-...

# --- Execution sandbox ------------------------------------------------------
# auto: Docker if the daemon is reachable, otherwise local only if explicitly allowed.
DEVFLOW_EXECUTOR=auto
DEVFLOW_SANDBOX_IMAGE=devflow-sandbox:latest
# Local execution runs generated code on this machine WITHOUT container isolation.
# Acceptable for the mock provider's scripted code; use Docker for model-generated code.
DEVFLOW_ALLOW_LOCAL_EXECUTION=false
DEVFLOW_EXEC_TIMEOUT_SECONDS=120
DEVFLOW_EXEC_MEMORY_MB=512

# --- Limits -------------------------------------------------------------------
DEVFLOW_MAX_DEBUG_ATTEMPTS=3
DEVFLOW_MAX_REVIEW_ROUNDS=1
DEVFLOW_MAX_COST_USD=5.0
DEVFLOW_MAX_WORKFLOW_SECONDS=3600

# --- Storage ------------------------------------------------------------------
# Defaults to SQLite under backend/data. For PostgreSQL:
# DEVFLOW_DATABASE_URL=postgresql+psycopg://devflow:devflow@localhost:5432/devflow
# DEVFLOW_DATA_DIR=C:/DevFlowData
# DEVFLOW_SECRET_KEY=   # generated and stored in the data dir when unset
